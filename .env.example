# ==============================================================================
# MODELRYX ENVIRONMENT CONFIGURATION
# ==============================================================================
# 
# CRITICAL: Do NOT commit the .env file to version control!
# This file contains sensitive credentials and must be kept private.
# All REQUIRED variables must be set before starting the application.
#
# Generate secure values:
#   JWT_SECRET (32+ chars): python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   WORKER_KEY (32+ chars): python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#   POSTGRES_PASSWORD:      python3 -c "import secrets; print(secrets.token_urlsafe(16))"
#   MINIO_PASSWORD:         python3 -c "import secrets; print(secrets.token_urlsafe(16))"
#
# ==============================================================================

# DATABASE CONFIGURATION (REQUIRED)
# PostgreSQL connection credentials - must be set before first deployment
POSTGRES_PASSWORD=replace-with-secure-random-password-32-chars
MODELRYX_DATABASE_URL=postgresql://modelryx:${POSTGRES_PASSWORD}@db:5432/modelryx

# DATABASE CONNECTION POOLING (optional, values shown are defaults)
MODELRYX_DATABASE_POOL_SIZE=20
MODELRYX_DATABASE_MAX_OVERFLOW=40
MODELRYX_DATABASE_POOL_TIMEOUT=30
MODELRYX_DATABASE_POOL_RECYCLE=3600

# OBJECT STORAGE (MinIO) - REQUIRED
# MinIO provides S3-compatible object storage for file uploads and artifacts
# Can be replaced with AWS S3 or compatible service in production
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-secure-random-password-32-chars
# MinIO endpoints (internal for Docker, adjust for external)
MODELRYX_MINIO_ENDPOINT=minio:9000
MODELRYX_MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MODELRYX_MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MODELRYX_MINIO_SECURE=false
MODELRYX_MINIO_BUCKET=modelryx-objects

# APPLICATION ENVIRONMENT (REQUIRED)
# Valid values: development, test, production
# In production: strict validation of secrets, no weak defaults allowed
MODELRYX_ENVIRONMENT=development

# AUTHENTICATION SECRETS (REQUIRED)
# JWT_SECRET: Must be 32+ characters for production, unique per deployment
MODELRYX_JWT_SECRET=replace-with-at-least-32-random-characters
# INTERNAL_WORKER_KEY: Shared secret for CAD worker authentication (32+ characters)
MODELRYX_INTERNAL_WORKER_KEY=replace-with-a-long-random-worker-key

# BOOTSTRAP ADMIN ACCOUNT (REQUIRED)
# These credentials are used only during initial database migration
# Change them immediately after first login in production
MODELRYX_BOOTSTRAP_ADMIN_USERNAME=admin
MODELRYX_BOOTSTRAP_ADMIN_PASSWORD=replace-with-secure-admin-password-32-chars

# AI SERVICES (optional)
MODELRYX_AI_GATEWAY_BASE_URL=
MODELRYX_AI_GATEWAY_API_KEY=
MODELRYX_AI_CHAT_MODEL=
MODELRYX_AI_EMBEDDING_MODEL=
MODELRYX_AI_EMBEDDING_DIMENSIONS=1536

# CAD WORKER CONFIGURATION
# FreeCAD worker URL (optional; if set, enables advanced CAD processing)
MODELRYX_FREECAD_WORKER_URL=

# STEP worker runs in Docker by default; other workers deploy externally
MODELRYX_STEP_WORKER_URL=http://step-worker:8080

# CAD Analyzer URL (optional; used for CAD resource estimation)
MODELRYX_CAD_ANALYZER_URL=http://freecad-analyzer:8090

# Deprecated: These workers are no longer shipped with open-source Modelryx
# They are provided as examples for external deployment patterns
MODELRYX_AUTOCAD_WORKER_URL=http://host.docker.internal:5080
MODELRYX_INVENTOR_WORKER_URL=http://host.docker.internal:5091
MODELRYX_NX_WORKER_URL=http://host.docker.internal:5092
MODELRYX_NX_ALLOW_UNQUALIFIED_PROCESSING=false

# SERVER CONFIGURATION
MODELRYX_SERVER_URL=http://localhost:8000
MODELRYX_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
MODELRYX_LOG_LEVEL=INFO

# RELEASE APPROVAL WORKFLOW (optional)
MODELRYX_REQUIRE_RELEASE_APPROVAL=false
MODELRYX_APPROVAL_REQUIRED_COUNT=1
MODELRYX_APPROVAL_ASSEMBLY_REQUIRED_COUNT=1
MODELRYX_APPROVAL_DUE_HOURS=72
MODELRYX_APPROVAL_EMERGENCY_DUE_HOURS=4

# FREECAD WORKER RESOURCES (optional, tuned for container capacity)
# Adjust based on your deployment's workload and hardware
MODELRYX_FREECAD_MEMORY_LIMIT=8g
MODELRYX_FREECAD_PIDS_LIMIT=512
MODELRYX_FREECAD_STAGE_TIMEOUT_SECONDS=

# STEP WORKER RETENTION (optional, cleanup processing artifacts)
# How long to keep conversion artifacts (in seconds, default: 86400 = 1 day)
MODELRYX_STEP_WORKER_RETENTION_SECONDS=86400

# CAD CONVERSION TIMEOUTS (optional, adjust based on model complexity and network)
# How long to wait for CAD conversion operations to complete (seconds)
MODELRYX_CONVERTER_TIMEOUT_SECONDS=1800
# How long before declaring a worker offline/disconnected (seconds)
MODELRYX_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30
# How long to wait for AI/LLM requests to complete (seconds)
MODELRYX_AI_REQUEST_TIMEOUT_SECONDS=60

