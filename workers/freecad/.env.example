# Independent FreeCAD worker configuration. Copy to .env in this directory.
# Must match the Modelryx server's worker key; do not commit actual credentials.
MODELRYX_INTERNAL_WORKER_KEY=replace-with-the-shared-worker-key
MODELRYX_FREECAD_BIND_ADDRESS=127.0.0.1
MODELRYX_FREECAD_PORT=8090
MODELRYX_CONVERTER_VERSION=modelryx-fcstd-29
MODELRYX_FREECAD_MEMORY_LIMIT=8g
MODELRYX_FREECAD_PIDS_LIMIT=512
MODELRYX_FREECAD_STAGE_TIMEOUT_SECONDS=
