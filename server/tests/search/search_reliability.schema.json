{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "cases"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "const": "1"},
    "matrices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id_prefix", "partition", "variables", "variants"],
        "properties": {
          "id_prefix": {"type": "string", "minLength": 1},
          "partition": {"enum": ["development", "locked"]},
          "critical": {"type": "boolean"},
          "traits": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "variables": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "query", "expected"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "query": {"type": "string", "minLength": 2},
                "values": {"type": "object", "additionalProperties": {"type": "string"}},
                "critical": {"type": "boolean"},
                "traits": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "equivalence_group": {"type": "string"},
                "expected": {"type": "object"},
                "must_be_unset": {"type": "array", "items": {"type": "string"}},
                "expected_residual_terms": {"type": "array", "items": {"type": "string"}},
                "warning_contains": {"type": "array", "items": {"type": "string"}},
                "consumed_phrases": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "partition", "query", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "partition": {"enum": ["development", "locked"]},
          "query": {"type": "string", "minLength": 2},
          "critical": {"type": "boolean"},
          "traits": {
            "type": "array",
            "items": {"enum": ["paraphrase", "negation", "ambiguous_or_unsupported", "informal", "spelling"]},
            "uniqueItems": true
          },
          "equivalence_group": {"type": "string", "minLength": 1},
          "expected": {"type": "object"},
          "must_be_unset": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "expected_residual_terms": {"type": "array", "items": {"type": "string"}},
          "warning_contains": {"type": "array", "items": {"type": "string"}},
          "consumed_phrases": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
