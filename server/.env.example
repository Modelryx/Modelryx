MODELRYX_DATABASE_URL=postgresql+psycopg://modelryx:modelryx@db:5432/modelryx
MODELRYX_ENVIRONMENT=development
MODELRYX_STORAGE_ROOT=/var/lib/modelryx/objects
MODELRYX_JWT_SECRET=replace-with-at-least-32-random-characters
MODELRYX_JWT_ISSUER=modelryx
MODELRYX_JWT_EXPIRY_MINUTES=60
MODELRYX_BOOTSTRAP_ADMIN_USERNAME=admin
MODELRYX_BOOTSTRAP_ADMIN_PASSWORD=replace-this-password
MODELRYX_BOOTSTRAP_ADMIN_DISPLAY_NAME=Modelryx Administrator
MODELRYX_CORS_ORIGINS=["http://localhost:5173"]
MODELRYX_LOG_LEVEL=INFO
MODELRYX_MAX_UPLOAD_BYTES=2147483648
MODELRYX_MAX_ASSEMBLY_FILES=500
MODELRYX_MAX_ASSEMBLY_OCCURRENCES=10000
MODELRYX_MAX_ASSEMBLY_UPLOAD_BYTES=21474836480
MODELRYX_UPLOAD_EXPIRY_SECONDS=3600
MODELRYX_CHECKOUT_EXPIRY_SECONDS=28800
MODELRYX_REQUIRE_RELEASE_APPROVAL=false
MODELRYX_APPROVAL_REQUIRED_COUNT=1
MODELRYX_APPROVAL_ASSEMBLY_REQUIRED_COUNT=1
MODELRYX_APPROVAL_DUE_HOURS=72
MODELRYX_APPROVAL_EMERGENCY_DUE_HOURS=4
MODELRYX_ORPHAN_GRACE_SECONDS=86400
MODELRYX_INTERNAL_WORKER_KEY=replace-with-the-shared-worker-key
MODELRYX_WORKER_POLL_SECONDS=2
# The orchestrator dispatches processing to external CAD servers.
MODELRYX_PROCESSING_WORKER_ROLE=general
# Optional defaults; registered worker capabilities determine native CAD support.
# MODELRYX_CAD_WORKER_URL=http://cad-worker:5093
# MODELRYX_CAD_PREPROCESSOR_URL=http://cad-preprocessor:5094
# Legacy MODELRYX_FREECAD_WORKER_URL / MODELRYX_FREECAD_PREPROCESSOR_URL are fallback aliases.
# An explicitly empty generic URL disables its legacy fallback.
MODELRYX_AI_GATEWAY_BASE_URL=https://api.openai.com/v1
MODELRYX_AI_GATEWAY_API_KEY=
# Chat providers: openai_compatible (legacy gateway), openai, anthropic (Claude), gemini
MODELRYX_AI_CHAT_PROVIDER=openai_compatible
MODELRYX_AI_CHAT_BASE_URL=
MODELRYX_AI_CHAT_API_KEY=
MODELRYX_AI_CHAT_MODEL=gpt-5.4-nano
MODELRYX_AI_CHAT_MAX_OUTPUT_TOKENS=4096
MODELRYX_AI_TOOL_CALLING_ENABLED=false
MODELRYX_AI_TOOL_MAX_CALLS=6
MODELRYX_AI_TOOL_MAX_ROUNDS=3
MODELRYX_AI_TOOL_TIMEOUT_SECONDS=30
MODELRYX_AI_EMBEDDING_MODEL=
MODELRYX_AI_EMBEDDING_DIMENSIONS=1536
MODELRYX_DUPLICATE_METADATA_WEIGHT=0.75
MODELRYX_DUPLICATE_EMBEDDING_WEIGHT=0.25
MODELRYX_DUPLICATE_ENGINEERING_MIN=0.985
MODELRYX_DUPLICATE_LIKELY_MIN=0.90
MODELRYX_DUPLICATE_SIMILAR_MIN=0.72
MODELRYX_DUPLICATE_AI_REVIEW_MIN=0.88
MODELRYX_DUPLICATE_AI_REVIEW_MAX=0.985
MODELRYX_DUPLICATE_MAX_AI_CANDIDATES=5
