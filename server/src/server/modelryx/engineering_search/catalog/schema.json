{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "scenarios"],
  "properties": {
    "version": {"type": "string", "pattern": "^scenario-catalog/v[1-9][0-9]*$"},
    "status": {"const": "published"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "status", "priority", "entities", "operation", "capabilities", "owner", "canonical_example", "paraphrases", "negative_examples", "example_request", "configuration"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
          "version": {"type": "integer", "minimum": 1},
          "status": {"enum": ["published", "disabled"]},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "entities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["item", "part", "assembly"]}},
          "operation": {"const": "engineering_search"},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "owner": {"type": "string", "minLength": 1},
          "canonical_example": {"type": "string", "minLength": 2},
          "paraphrases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "negative_examples": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
          "example_request": {"type": "object"},
          "configuration": {"type": "object"}
        }
      }
    }
  }
}
