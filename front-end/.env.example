# Modelryx Frontend Environment Configuration
# 
# This file configures the React/Vite frontend for the Modelryx platform.
# Do NOT commit this file to version control if it contains secrets.
#
# Copy to .env.local for local development, or use CI/CD to inject at build time.

# ==============================================================================
# API CONFIGURATION
# ==============================================================================

# Backend API URL - must be accessible from browser
# For local development: http://localhost:8000
# For production: https://your-domain.com or https://api.your-domain.com
VITE_API_URL=http://localhost:8000

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================

# Enable experimental features (development only)
VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# Enable verbose logging
VITE_DEBUG_MODE=true

# Enable AI features (requires backend AI gateway configured)
VITE_ENABLE_AI_FEATURES=false

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# ==============================================================================
# DEVELOPMENT CONFIGURATION
# ==============================================================================

# Development server port (default: 5173)
VITE_DEV_SERVER_PORT=5173

# Enable source maps for debugging
VITE_SOURCEMAP=true

# ==============================================================================
# BUILD CONFIGURATION
# ==============================================================================

# Build output directory (relative to front-end/)
VITE_BUILD_OUTDIR=dist

# Asset file size warning threshold (in bytes)
VITE_CHUNK_SIZE_WARNING_LIMIT=500

# ==============================================================================
# ANALYTICS & MONITORING (Optional)
# ==============================================================================

# Google Analytics ID (optional)
VITE_GOOGLE_ANALYTICS_ID=

# Sentry DSN for error reporting (optional)
VITE_SENTRY_DSN=

# ==============================================================================
# DEPLOYMENT VARIABLES
# ==============================================================================

# Application version (inject via CI/CD)
VITE_APP_VERSION=1.0.0

# Build timestamp (inject via CI/CD)
VITE_BUILD_TIME=

# Environment name (development/staging/production)
VITE_ENVIRONMENT=development
